<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:background="#E5D0AC"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_60"
        android:background="@color/app_theme_color">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="@dimen/size_5">
            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:text="@string/music_picker_title"
                style="@style/ToolbarTitleStyle"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_size_26"
                android:layout_gravity="center"/>
        </RelativeLayout>

    </androidx.appcompat.widget.Toolbar>

    <androidx.wear.widget.WearableRecyclerView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:id="@+id/music_list"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#E96900"
        android:gravity="center_horizontal"
        android:paddingBottom="@dimen/size_14"
        android:paddingTop="@dimen/size_8"
        android:paddingHorizontal="@dimen/size_12"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/size_64"
            android:layout_marginEnd="@dimen/size_6"
            android:layout_weight="1"
            android:id="@+id/cancelButton"
            android:paddingEnd="@dimen/size_20"
            android:background="@drawable/button_dialog_bg">
            <ImageView
                android:layout_width="@dimen/size_64"
                android:layout_height="@dimen/size_64"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@android:color/transparent"
                android:padding="@dimen/size_8"
                android:src="@drawable/ic_close" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/size_64"
            android:id="@+id/okayButton"
            android:layout_weight="1"
            android:paddingStart="@dimen/size_20"
            android:enabled="false"
            android:background="@drawable/button_dialog_bg">
            <ImageView
                android:id="@+id/okayButtonIcon"
                android:layout_width="@dimen/size_64"
                android:layout_height="@dimen/size_64"
                android:padding="@dimen/size_8"
                android:layout_alignParentStart="true"
                android:background="@android:color/transparent"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_done" />
        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>
