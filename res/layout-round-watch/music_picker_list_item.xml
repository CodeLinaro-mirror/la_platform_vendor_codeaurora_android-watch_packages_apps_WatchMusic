<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/size_1"
    android:background="@drawable/song_item_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/size_10"
    android:paddingHorizontal="@dimen/size_10">

    <TextView
        android:id="@+id/title"
        style="@style/LargeTextStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/play_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_7"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:contentDescription="@string/more"
        android:src="@drawable/indicator_ic_mp_playing_list" />

</LinearLayout>